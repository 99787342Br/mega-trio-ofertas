// Função para agrupar produtos por categoria
function agruparProdutos(produtos) {
  return produtos.reduce((acc, produto) => {
    const categoria = produto.categoria;
    if (!acc[categoria]) {
      acc[categoria] = [];
    }
    acc[categoria].push(produto);
    return acc;
  }, {});
}

// Função para renderizar os produtos na página
function renderizarProdutos(produtos) {
  const container = document.getElementById('produtos-container');
  const produtosAgrupados = agruparProdutos(produtos);
  
  // Limpa o conteúdo existente (se houver)
  container.innerHTML = ''; 

  for (const categoria in produtosAgrupados) {
    const produtosHTML = produtosAgrupados[categoria].map(produto => {
      // Ajusta o texto do link WhatsApp para ser seguro em URL
      const whatsappTexto = encodeURIComponent(`Quero comprar o ${produto.nome} na promoção Leve 3, Pague 1`);
      const whatsappLink = `https://wa.me/5521999999999?text=${whatsappTexto}`;

      return `
        <div class="produto">
          <img src="${produto.imagem}" alt="${produto.nome}">
          <h3>${produto.nome}</h3>
          <p>${produto.descricao}</p>
          <p class="preco">${produto.preco} (3x1)</p>
          <a href="${whatsappLink}" class="btn" target="_blank">Comprar via WhatsApp</a>
        </div>
      `;
    }).join('');

    const categoriaSection = `
      <section class="categoria">
        <h2>${categoria}</h2>
        <div class="produtos">
          ${produtosHTML}
        </div>
      </section>
    `;
    
    container.innerHTML += categoriaSection;
  }
}

// Inicia a renderização dos produtos
renderizarProdutos(produtosData);

// Contador regressivo 24 horas
function iniciarContador() {
  // Define o fim da contagem para 24 horas a partir do carregamento
  // Para fins de teste/demonstração, você pode usar um valor fixo no LocalStorage para persistir a contagem
  let fimContagem = localStorage.getItem('fimContagem');
  if (!fimContagem || new Date().getTime() > fimContagem) {
    // Se não houver ou se o tempo já passou, define um novo período de 24h
    fimContagem = new Date().getTime() + (24 * 60 * 60 * 1000); 
    localStorage.setItem('fimContagem', fimContagem);
  }
  
  const fim = parseInt(fimContagem);

  const timer = setInterval(function() {
    const agora = new Date().getTime();
    const restante = fim - agora;
    
    const horas = Math.floor((restante % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutos = Math.floor((restante % (1000 * 60 * 60)) / (1000 * 60));
    const segundos = Math.floor((restante % (1000 * 60)) / 1000);
    
    // Formatação para garantir dois dígitos (ex: 09h 05m 01s)
    const formato = `${String(horas).padStart(2, '0')}h ${String(minutos).padStart(2, '0')}m ${String(segundos).padStart(2, '0')}s`;
    
    document.getElementById("contador").innerHTML = formato;
    
    if (restante < 0) {
      clearInterval(timer);
      document.getElementById("contador").innerHTML = "Oferta encerrada!";
      localStorage.removeItem('fimContagem'); // Limpa para a próxima visita
    }
  }, 1000);
}
iniciarContador();
</script>

